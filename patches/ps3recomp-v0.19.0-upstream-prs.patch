+#!/usr/bin/env python3
+"""Exercise TOC preservation through the real dispatcher, without game code."""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main():
+    if os.name == 'nt':
+        print('SKIP: standalone dispatcher fixture requires a POSIX toolchain')
+        return 0
+    with tempfile.TemporaryDirectory(prefix='ppu-hle-toc-') as directory:
+        tmp = Path(directory)
+        (tmp / 'ppu_recomp.h').write_text('#include "ppu_context.h"\n')
+        includes = ['-I' + str(p) for p in (ROOT / 'include', ROOT / 'runtime/ppu', tmp)]
+        subprocess.run([os.environ.get('CXX', 'c++'), '-std=c++17', '-O1', '-UNDEBUG',
+                        *includes, str(ROOT / 'tests/test_ppu_hle_fast_toc.cpp'),
+                        str(ROOT / 'runtime/ppu/ppu_hle.cpp'), '-pthread',
+                        '-o', str(tmp / 'fixture')], check=True, timeout=45)
+        env = {k: v for k, v in os.environ.items()
+               if k in ('PATH', 'HOME', 'TMPDIR', 'SYSTEMROOT')}
+        subprocess.run([str(tmp / 'fixture')], env=env, check=True, timeout=10)
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/tools/test_ppu_resv_registry.py b/tools/test_ppu_resv_registry.py
new file mode 100755
index 00000000..c5b89a04
--- /dev/null
+++ b/tools/test_ppu_resv_registry.py
@@ -0,0 +1,62 @@
+#!/usr/bin/env python3
+"""The PPU reservation registry keeps one entry per distinct context.
+
+Builds the real runtime/ppu/ppu_loader.cpp with
+runtime/ppu/tests/test_ppu_resv_registry.cpp and runs each case in its own
+process (the registry is process-global): a context registered after another
+context was registered 256 times -- a thread slot reused by many thread starts --
+must still have its reservation broken by a store-conditional, a plain store
+and a line write; the same holds with eight threads registering at once; 128
+distinct contexts fit; a 129th stops the process with a message instead of
+running unregistered.
+"""
+import os
+import signal
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from check_ppu_scaffold import stub_header  # noqa: E402
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main():
+    if os.name == 'nt':
+        print('SKIP: fixture builds with the POSIX toolchain flags')
+        return
+    with tempfile.TemporaryDirectory(prefix='ppu-resv-registry-') as tmp:
+        tmp = Path(tmp)
+        (tmp / 'ppu_recomp.h').write_text(stub_header())
+        binary = tmp / 'test'
+        flags = ['-Wl,-dead_strip'] if sys.platform == 'darwin' else ['-Wl,--gc-sections', '-ldl']
+        subprocess.run([os.environ.get('CXX', 'c++'), '-std=c++17', '-O1', '-w', '-pthread',
+                        '-ffunction-sections', '-fdata-sections',
+                        '-I' + str(tmp), '-I' + str(ROOT / 'include'), '-I' + str(ROOT / 'runtime/platform'),
+                        str(ROOT / 'runtime/ppu/ppu_loader.cpp'),
+                        str(ROOT / 'runtime/ppu/tests/test_ppu_resv_registry.cpp'),
+                        *flags, '-o', str(binary)], check=True)
+        env = {k: v for k, v in os.environ.items() if not k.startswith(('PPU_', 'PS3_', 'PS3RECOMP_', 'SPU_', 'RESV_'))}
+        failed = []
+        for mode in ('baseline', 'churn', 'concurrent', 'capacity'):
+            r = subprocess.run([str(binary), mode], env=env, capture_output=True, text=True, timeout=60)
+            print(r.stdout, end='')
+            if r.returncode:
+                sys.stderr.write(r.stderr[-2000:])
+                failed.append(mode)
+        r = subprocess.run([str(binary), 'overflow'], env=env, capture_output=True, text=True, timeout=60)
+        print(r.stdout, end='')
+        if r.returncode == -signal.SIGABRT and 'reservation registry exhausted: capacity=128' in r.stderr:
+            print('[PASS] a 129th distinct context stops the process with a message')
+        else:
+            print(f'[FAIL] a 129th distinct context: exit {r.returncode}, stderr {r.stderr.strip()[-300:]!r}')
+            failed.append('overflow')
+        if failed:
+            raise SystemExit('FAIL: reservation registry: ' + ', '.join(failed))
+        print('PASS: every distinct context stays reachable by reservation breaks')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/test_sys_event_queue_race.py b/tools/test_sys_event_queue_race.py
new file mode 100644
index 00000000..7854ef83
--- /dev/null
+++ b/tools/test_sys_event_queue_race.py
@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+"""Host producers pushing into event queues the guest creates and destroys, on Windows and POSIX.
+
+Builds runtime/syscalls/tests/test_sys_event_queue_race.c (which compiles in
+runtime/syscalls/sys_event.c) and runs it: producer threads resolve a key and push
+while the guest creates and destroys that queue through both create paths.
+"""
+import argparse
+import os
+import shutil
+import subprocess
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCE = ROOT / 'runtime/syscalls/tests/test_sys_event_queue_race.c'
+windows = os.name == 'nt'
+compiler = os.environ.get('CC', 'clang-cl' if windows else 'cc')
+msvc_style = Path(compiler).stem.lower() in ('clang-cl', 'cl')
+if not shutil.which(compiler):
+    raise SystemExit(f'compiler {compiler!r} not found')
+includes = [ROOT / 'include', ROOT / 'runtime', ROOT / 'runtime/syscalls']
+parser = argparse.ArgumentParser()
+parser.add_argument('--source', type=Path, help='alternate sys_event.c for a negative control')
+args = parser.parse_args()
+
+with tempfile.TemporaryDirectory(prefix='sys-event-race-') as tmp:
+    source = SOURCE
+    if args.source:
+        source = Path(tmp) / 'fixture.c'
+        source.write_text(SOURCE.read_text().replace('#include "../sys_event.h"',
+                          '#include "sys_event.h"').replace('#include "../sys_event.c"',
+                          '#include "' + args.source.resolve().as_posix() + '"'))
+    binary = Path(tmp) / ('test.exe' if windows else 'test')
+    if msvc_style:
+        command = [compiler, '/nologo', '/std:c17', '/O2', '/D_CRT_SECURE_NO_WARNINGS',
+                   *('/I' + str(i) for i in includes), str(source), '/Fe' + str(binary)]
+    else:
+        command = [compiler, '-std=gnu17', '-O2', '-UNDEBUG', *('-I' + str(i) for i in includes),
+                   str(source), *([] if windows else ['-pthread']), '-o', str(binary)]
+    subprocess.run(command, check=True, timeout=180, cwd=tmp)
+    for attempt in range(3):
+        run = subprocess.run([str(binary)], cwd=tmp, timeout=180, capture_output=True, text=True)
+        print(run.stdout.strip(), flush=True)
+        if run.returncode != 0:
+            print(run.stderr[-2000:])
+            raise SystemExit(f'test_sys_event_queue_race failed (exit {run.returncode:#x}) on run {attempt + 1}')
+print('PASS')
