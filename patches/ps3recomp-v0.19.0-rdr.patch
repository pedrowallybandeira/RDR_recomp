+static inline uint32_t q_r32(uint32_t a)
+{
+    const uint8_t* p = vm_base + a;
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
