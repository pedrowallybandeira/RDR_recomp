+/* SDK ABI: cellSpursQueuePopBody(CellSpursQueue*, void* buffer, bool isPeek, bool isBlocking)
+ *
+ * RDR2 creates a batch of SPU tasks and then pops one result per task. Without a
+ * handler the import returned CELL_OK with nothing popped, so the PPU never waited
+ * for the batch and the ring filled at depth entries; every later task then parked
+ * or spun on push, one host thread each, adding 30 threads a second.
+ *
+ * The producer is the SPU task library (0x11510 in the task images): W1 holds ~index
+ * while a push is in flight, so normalised occupancy only counts finished entries.
+ * A full ring parks the task in a waiter list at +0x30, byte 0 the count and byte 1
+ * the head, capped at 14; the task unlinks itself when it retries, so a pop only
+ * signals the head. Late arrivals past the cap retry through GETLLAR, which is why
+ * W0 is written under the lock-line lock with reservers notified.
+ *
+ * The real PPU side sleeps on the attached lv2 queue. Here it polls: no SPU code
+ * sends that event, because cellSpursQueueAttachLv2EventQueue binds nothing. */
+s32 cellSpursQueuePopBody(u64 queue_ea, u64 data_ea, u32 isPeek, u32 isBlocking)
+{
+    if (!queue_ea || !data_ea) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
+    if (queue_ea & 0x7F)       return CELL_SPURS_TASK_ERROR_ALIGN;
+
+    extern void spu_taskset_signal_task(uint32_t taskset_ea, uint32_t taskId);
+    uint32_t q = (uint32_t)queue_ea;
+    int reported = 0;
+    for (unsigned spin = 0;; spin++) {
+        spu_lockline_lock();
+        int32_t  w0  = (int32_t)q_r32(q + 0x00);
+        int32_t  w1  = (int32_t)q_r32(q + 0x04);
+        int32_t  mod = (int32_t)q_r32(q + 0x0C);
+        uint32_t sz  = q_r32(q + 0x10);
+        uint32_t buf = q_r32(q + 0x1C);
+        uint32_t tsp = q_r32(q + 0x74);
+        if (mod <= 0 || !sz || !buf) {
+            spu_lockline_unlock();
+            return CELL_SPURS_TASK_ERROR_INVAL;
+        }
+        int32_t  pop  = (w0 < 0) ? ~w0 : w0;
+        int32_t  push = (w1 < 0) ? ~w1 : w1;
+        uint32_t n    = (uint32_t)((pop > push) ? push - pop + 2 * mod : push - pop);
+        int      head = vm_base[q + 0x30] ? vm_base[q + 0x31] : -1;
+        if (n) {
+            uint32_t slot = (uint32_t)(pop % mod);
+            memcpy(vm_base + (uint32_t)data_ea, vm_base + buf + (size_t)slot * sz, sz);
+            if (!isPeek) q_w32(q + 0x00, (uint32_t)((pop + 1) % (2 * mod)));
+            ef_line_end(q);
+            if (!isPeek && head >= 0 && tsp) spu_taskset_signal_task(tsp, (uint32_t)head);
+            return CELL_OK;
+        }
+        spu_lockline_unlock();
+        if (!isBlocking) return CELL_SPURS_TASK_ERROR_BUSY;
+
+        if (spin < 64) { SwitchToThread(); continue; }
+        /* A head signalled twice before it unlinked leaves the next waiter asleep
+         * with room in the ring, so repeat it while the consumer is starving. */
+        if (head >= 0 && tsp) spu_taskset_signal_task(tsp, (uint32_t)head);
+        Sleep(1);
+        if (!reported && spin > 5000) {
+            reported = 1;
+            printf("[cellSpurs] QueuePopBody(q=0x%08X) waiting for over 5 s: pop=%d push=%d waiters=%d\n",
+                   q, pop, push, vm_base[q + 0x30]);
+        }
+    }
+}
