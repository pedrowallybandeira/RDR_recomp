+static inline void q_w32(uint32_t a, uint32_t v)
+{
+    uint8_t* p = vm_base + a;
+    p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
