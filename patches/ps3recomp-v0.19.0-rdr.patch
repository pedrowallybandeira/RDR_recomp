+    case 0x0188: s_m2mf.dma_out   = v; return 1;
+    case 0x030C: s_m2mf.off_in    = v; return 1;
+    case 0x0310: s_m2mf.off_out   = v; return 1;
+    case 0x0314: s_m2mf.pitch_in  = v; return 1;
