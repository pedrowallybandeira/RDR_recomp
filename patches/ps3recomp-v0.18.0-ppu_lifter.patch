diff --git a/tools/test_ppu_jumptables.py b/tools/test_ppu_jumptables.py
index 64ed245..5bc4fae 100644
--- a/tools/test_ppu_jumptables.py
+++ b/tools/test_ppu_jumptables.py
@@ -356,8 +356,59 @@ def test_bound_compare_beyond_window():
           [first + 4 * k for k in range(n)])
 
 
+def w_addic(rt, ra, si):   return (12 << 26) | (rt << 21) | (ra << 16) | (si & 0xFFFF)
+def w_lis(rt, si):         return w_addis(rt, 0, si)
+
+
+RDR2_TABLE = 0x10FFF0                               # 0x110000 - 0x10
+
+
+def rdr2_mem():
+    return {RDR2_TABLE: 0x10100, RDR2_TABLE + 4: 0x10104, RDR2_TABLE + 8: 0}
+
+
+def test_lis_addic_constant_base():
+    """Threaded interpreter: the table base is a constant, never in the TOC.
+
+        lis r15, 0x11 ; addic r15, r15, -0x10    <- base set once at entry
+        rlwinm r4, r3, 2, 0, 29
+        lwzx r4, r15, r4 ; mtctr r4 ; bctr       <- every handler ends like this
+
+    Before the fix no candidate resolved and all 172 such RDR2 dispatchers
+    lifted to unresolved indirect calls."""
+    words = [w_lis(15, 0x11), w_addic(15, 15, -0x10), w_slwi(4, 3, 2),
+             w_lwzx(4, 15, 4), w_mtctr(4), w_bctr()]
+    check("lis/addic constant base", discover(words, rdr2_mem()), [0x10100, 0x10104])
+
+
+def test_lwzx_that_feeds_mtctr_wins():
+    """Two indexed loads: the nearest is data, the mtctr source is the table.
+
+        lwzx r6, r15, r6        <- next handler
+        lwzx r3, r3, r4         <- operand of the current bytecode
+        mtctr r6 ; bctr
+
+    Taking the nearest lwzx looked for a base in r3/r4 and dropped RDR2's
+    dispatchers at 0xD18544 and 0xD18914."""
+    words = [w_lis(15, 0x11), w_addic(15, 15, -0x10), w_slwi(6, 6, 2), w_slwi(4, 4, 2),
+             w_lwzx(6, 15, 6), w_lwzx(3, 3, 4), w_mtctr(6), w_bctr()]
+    check("lwzx feeding mtctr wins", discover(words, rdr2_mem()), [0x10100, 0x10104])
+
+
+def test_addic_without_lis_is_no_base():
+    """A base register added to a value that is not `lis` is not a constant.
+    The memory at the would-be address holds valid targets on purpose, so a
+    loose match would report a false table here."""
+    words = [w_lwz(15, 3, 0), w_addic(15, 15, -0x10), w_slwi(4, 3, 2),
+             w_lwzx(4, 15, 4), w_mtctr(4), w_bctr()]
+    check("addic over a non-constant is rejected", discover(words, rdr2_mem()), None)
+
+
 def main() -> int:
     test_encodings()
+    test_lis_addic_constant_base()
+    test_lwzx_that_feeds_mtctr_wins()
+    test_addic_without_lis_is_no_base()
     test_absolute_base_is_second_operand()
     test_offset_idiom()
     test_offset_idiom_lwax()
